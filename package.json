{
  "name": "scrollsaber",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Afan Selçuk <afanselcuk@gmail.com>",
  "description": "Chrome extension that shortens long LinkedIn posts with your own LLM key (Gemini or any OpenAI-compatible API).",
  "repository": {
    "type": "git",
    "url": "https://github.com/AFN7/scrollsaber.git"
  },
  "bugs": "https://github.com/AFN7/scrollsaber/issues",
  "homepage": "https://github.com/AFN7/scrollsaber#readme",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm run icons && wxt build",
    "build:firefox": "pnpm run icons && wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-react": "^4.3.3",
      "vite": "^5.4.11"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wxt-dev/module-react": "^1.1.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wxt": "^0.19.13"
  }
}
